[TEMPLATE]
# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (least-privilege DB user, this database only)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rollshop?retryWrites=true&w=majority

# Port for the Express API
PORT=4000

# JWT signing secret — REQUIRED for login. Use a long random value.
JWT_SECRET=
# Shift length for the JWT (architecture.md §3). Default: 14h
JWT_EXPIRES_IN=14h
# Login rate limit: max attempts per minute (architecture.md §7)
LOGIN_RATE_LIMIT_MAX=10

# Owner account used by `pnpm seed` (run once; re-running is a safe no-op)
OWNER_NAME=Shop Owner
OWNER_USERNAME=9999999999
OWNER_PASSWORD=change-me-before-first-run
